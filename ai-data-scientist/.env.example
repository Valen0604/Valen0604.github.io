# Copy this file to `.env` (same folder) and fill in the key.
# `.env` is git-ignored. Never commit a key, and never paste one into chat or a screenshot.

# ---------------------------------------------------------------------------------------
# REQUIRED for the real agent. Get a key at https://console.anthropic.com/ -> API keys.
# Leave it empty and the app runs in offline demo mode.
# ---------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------
# Optional. The defaults are shown. Delete the leading "# " on a line to change it.
# ---------------------------------------------------------------------------------------

# Which Claude model answers. claude-sonnet-5 is the low-cost choice the course suggests.
# ADS_MODEL=claude-sonnet-5

# How hard the model works: low, medium, high, xhigh, max.
# Higher is more thorough and costs more. Medium is a good balance for analysis chat.
# ADS_EFFORT=medium

# Show the model a picture of each chart it draws, so it can read the chart as well as
# the numbers. Costs roughly 1,000 to 1,500 tokens per chart. Set to false to save money.
# ADS_SEND_CHARTS_TO_MODEL=true

# Show the model's reasoning summary in the chat.
# ADS_SHOW_THINKING=true

# The most tool calls the agent may make to answer one message.
# ADS_MAX_TOOL_ROUNDS=15

# Longest single response, in tokens. A cap, not a target.
# ADS_MAX_TOKENS=32000

# Time limits, in seconds, for code the agent writes and for model training.
# ADS_CODE_TIMEOUT_S=90
# ADS_MODEL_TIMEOUT_S=420

# Largest file that can be uploaded, in megabytes.
# ADS_MAX_UPLOAD_MB=200

# Where the server listens.
# ADS_HOST=127.0.0.1
# ADS_PORT=8000
